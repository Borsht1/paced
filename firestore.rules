rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can read and change only their own tasks.
    match /users/{uid}/docs/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Testers: one document per tester, named by the email they sign in with, with a "name" for their tab.
    // You add these in the Firebase console. Each tester can read only their own, so emails stay private.
    function testerDoc() {
      return /databases/$(database)/documents/testers/$(request.auth.token.email);
    }
    function isTester() {
      return request.auth != null && request.auth.token.email != null && exists(testerDoc());
    }
    match /testers/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
    }

    // Tester notes: every tester reads all of them, writes under their own account and name, and deletes only their own.
    match /testerNotes/{noteId} {
      allow read: if isTester();
      allow create: if isTester()
        && request.resource.data.author == request.auth.uid
        && request.resource.data.name == get(testerDoc()).data.name
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
      allow delete: if isTester() && resource.data.author == request.auth.uid;
    }
  }
}
